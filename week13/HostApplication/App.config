<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <system.serviceModel>
    <services>
      <service name="SocialInsuranceService.SocialInsuranceServiceImpl"
               behaviorConfiguration="SocialInsuranceServiceBehavior">

        <!-- Named Pipe Endpoint (No Admin Rights Required) -->
        <endpoint address="net.pipe://localhost/SocialInsuranceService"
                  binding="netNamedPipeBinding"
                  contract="SocialInsuranceService.ISocialInsuranceService" />

        <!-- HTTP Endpoint (Requires URL Registration) -->
        <endpoint address="http://localhost:8080/SocialInsuranceService"
                  binding="basicHttpBinding"
                  contract="SocialInsuranceService.ISocialInsuranceService" />

        <!-- MEX Endpoint for metadata exchange -->
        <endpoint address="mex"
                  binding="mexHttpBinding"
                  contract="IMetadataExchange" />

        <host>
          <baseAddresses>
            <add baseAddress="net.pipe://localhost/SocialInsuranceService" />
            <add baseAddress="http://localhost:8080/SocialInsuranceService" />
          </baseAddresses>
        </host>
      </service>
    </services>

    <behaviors>
      <serviceBehaviors>
        <behavior name="SocialInsuranceServiceBehavior">
          <!-- Enable metadata publishing -->
          <serviceMetadata httpGetEnabled="true" httpGetUrl="" />

          <!-- Enable debug information -->
          <serviceDebug includeExceptionDetailInFaults="true" />

          <!-- Allow large data transfers -->
          <dataContractSerializer maxItemsInObjectGraph="2147483647" />
        </behavior>
      </serviceBehaviors>
    </behaviors>

    <!-- Binding configurations for larger message sizes -->
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_ISocialInsuranceService"
                 maxBufferSize="2147483647"
                 maxReceivedMessageSize="2147483647"
                 receiveTimeout="00:10:00"
                 sendTimeout="00:10:00">
          <readerQuotas maxDepth="32"
                        maxStringContentLength="2147483647"
                        maxArrayLength="2147483647"
                        maxBytesPerRead="2147483647"
                        maxNameTableCharCount="2147483647" />
        </binding>
      </basicHttpBinding>
    </bindings>
  </system.serviceModel>
</configuration>
